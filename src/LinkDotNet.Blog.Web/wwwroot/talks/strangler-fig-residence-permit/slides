* @kind color */\n  --success-300: rgb(74,212,177); /* @kind color */\n  --success-400: rgb(29,201,158); /* @kind color */\n  --success-500: rgb(4,175,132); /* @kind color */\n  --success-50: rgb(210,244,236); /* @kind color */\n  --success-600: rgb(0,150,107); /* @kind color */\n  --success-700: rgb(0,125,82); /* @kind color */\n  --success-800: rgb(0,99,56); /* @kind color */\n  --success-900: rgb(0,74,31); /* @kind color */\n  --warning-100: rgb(255,225,240); /* @kind color */\n  --warning-200: rgb(255,196,226); /* @kind color */\n  --warning-300: rgb(255,166,211); /* @kind color */\n  --warning-400: rgb(255,137,197); /* @kind color */\n  --warning-500: rgb(255,107,182); /* @kind color */\n  --warning-50: rgb(255,240,248); /* @kind color */\n  --warning-600: rgb(229,82,156); /* @kind color */\n  --warning-700: rgb(204,56,131); /* @kind color */\n  --warning-800: rgb(178,31,106); /* @kind color */\n  --warning-900: rgb(153,5,80); /* @kind color */\n  --width-1008: 1008; /* @kind other */\n  --width-1152: 1152; /* @kind other */\n  --width-1440: 1440; /* @kind other */\n  --width-144: 144; /* @kind other */\n  --width-281-63: 281.63; /* @kind other */\n  --width-320: 320; /* @kind other */\n  --width-449-28: 449.28; /* @kind other */\n  --width-512: 512; /* @kind other */\n}\n\n/* No TEXT/EFFECT styles in this file. */\n\n/* SQUER — Semantic color tokens\n   Base palette scales live in fig-tokens.css (--primary-500, --neutral-900, …).\n   This file layers brand + semantic aliases on top. */\n\n:root {\n  /* ---- Brand ---- */\n  --squer-azure: var(--primary-500);        /* rgb(30,174,233) — signature accent */\n  --squer-navy: rgb(44,55,71);              /* deep brand navy */\n  --squer-black: var(--neutral-900);        /* rgb(16,16,16)  — near-black */\n  --squer-white: #ffffff;\n\n  --link-hover-blue: rgb(53,154,246);       /* footer link hover rule */\n\n  /* ---- Light surfaces ---- */\n  --surface-page: #ffffff;\n  --surface-raised: #ffffff;\n  --surface-muted: rgb(243,244,246);        /* workspace grey */\n  --surface-sunken: rgb(249,250,251);\n  --border-subtle: rgb(229,231,235);\n  --border-default: rgb(200,200,200);\n\n  /* ---- Dark surfaces (product default) ----\n     SQUER product & web UI is predominantly dark. */\n  --surface-dark-page: rgb(44,44,44);       /* darkmode-400 */\n  --surface-dark-default: rgb(36,36,36);    /* darkmode-600 — standard page/section bg */\n  --surface-dark-raised: rgb(46,46,46);     /* darkmode-300 */\n  --surface-dark-input: rgb(54,54,54);      /* darkmode-100 */\n  --surface-dark-deep: rgb(18,18,18);       /* darkmode-900 — deepest recess only (also --surface-recessed alias) */\n  --border-dark: rgba(255,255,255,0.1);\n\n  /* ---- Elevation (product UI, neutral dark scale) ----\n     Depth = surface LIGHTNESS, never drop shadows. Applies to the neutral\n     dark surfaces only — NOT to Dark Blue / brand-colored fills.\n     e.g. Card resting = page (400); Card hover = raised (300). */\n  --elevation-page: rgb(44,44,44);          /* 400 — page / base */\n  --elevation-raised: rgb(46,46,46);        /* 300 — card hover/active */\n  --elevation-popover: rgb(54,54,54);       /* 100 — popover/dropdown/tooltip */\n  --elevation-recessed-1: rgb(39,39,39);    /* 500 — recessive surface */\n  --elevation-recessed-2: rgb(18,18,18);    /* 900 — deepest recess */\n\n  /* ---- Text (on light) ---- */\n  --text-primary: rgb(16,16,16);\n  --text-secondary: rgb(92,92,92);\n  --text-tertiary: rgb(159,159,159);\n  --text-on-accent: #ffffff;\n  --text-link: var(--primary-700);\n\n  /* ---- Text (on dark) ---- */\n  --text-dark-primary: #ffffff;\n  --text-dark-secondary: rgb(159,159,159);\n  --text-dark-tertiary: rgb(131,131,131);\n\n  /* ---- Semantic / status (uses the base scales) ---- */\n  --accent: var(--primary-500);\n  --accent-hover: var(--primary-700);\n  --success: var(--success-500);\n  --warning: var(--warning-500);            /* SQUER \"warning\" is pink */\n  --destructive: var(--destructive-400);\n  --info: var(--primary-500);\n\n  /* ---- Badge 'accent' style — theme-dependent bg + ink ----\n     Light: pale 50-tint bg + dark ink. Dark: saturated bg + white ink\n     (overridden in .squer-dark below). 'filled'/'outlined' are unaffected. */\n  --badge-accent-bg-primary: var(--primary-50);\n  --badge-accent-bg-warning: var(--warning-50);\n  --badge-accent-bg-success: var(--success-50);\n  --badge-accent-bg-destructive: var(--destructive-50);\n  --badge-accent-bg-neutral: var(--neutral-50);\n  --badge-accent-ink-primary: var(--primary-700);\n  --badge-accent-ink-warning: var(--warning-800);\n  --badge-accent-ink-success: var(--success-700);\n  --badge-accent-ink-destructive: var(--destructive-700);\n  --badge-accent-ink-neutral: var(--neutral-800);\n\n  /* Scope-independent dark accent values — referenced directly by <Badge dark>\n     so the dark treatment never depends on a parent .squer-dark class. */\n  --badge-accent-dark-bg-primary: rgb(40,96,152);\n  --badge-accent-dark-bg-warning: rgb(163,47,105);\n  --badge-accent-dark-bg-success: rgb(41,97,60);\n  --badge-accent-dark-bg-destructive: rgb(139,26,16);\n  --badge-accent-dark-bg-neutral: var(--neutral-600);\n  --badge-accent-dark-ink: #fff;\n}\n\n/* Opt-in dark scope: <div class=\"squer-dark\"> or [data-theme=\"dark\"] */\n.squer-dark, [data-theme=\"dark\"] {\n  --surface-page: var(--surface-dark-page);\n  --surface-raised: var(--surface-dark-raised);\n  --surface-recessed: var(--surface-dark-deep);\n  --border-subtle: var(--border-dark);\n  --border-default: var(--border-dark);\n  --text-primary: var(--text-dark-primary);\n  --text-secondary: var(--text-dark-secondary);\n  --text-tertiary: var(--text-dark-tertiary);\n  --text-link: var(--primary-400);\n\n  /* Badge 'accent' — final dark-mode bg values, white ink throughout */\n  --badge-accent-bg-primary: rgb(40,96,152);\n  --badge-accent-bg-warning: rgb(163,47,105);\n  --badge-accent-bg-success: rgb(41,97,60);\n  --badge-accent-bg-destructive: rgb(139,26,16);\n  --badge-accent-bg-neutral: var(--neutral-600);   /* rgb(118,118,118) — final */\n  --badge-accent-ink-primary: #fff;\n  --badge-accent-ink-warning: #fff;\n  --badge-accent-ink-success: #fff;\n  --badge-accent-ink-destructive: #fff;\n  --badge-accent-ink-neutral: #fff;\n}\n\na { color: var(--text-link); text-decoration: none; }\na:hover { color: var(--accent-hover); text-decoration: underline; }\n\n/* SQUER — Typography scale\n   Values transcribed verbatim from the Figma \"Responsive typography scale\".\n   Headings & body: Museo Sans, tracking -2% on headings (see readme). */\n\n:root {\n  /* Font sizes */\n  --fs-display-lg: 52px;\n  --fs-h1: 40px;\n  --fs-h2: 36px;\n  --fs-h3: 32px;\n  --fs-h4: 28px;\n  --fs-body: 18px;\n  --fs-quote: 16px;\n  --fs-caption: 14px;\n  --fs-micro: 12px;\n  --fs-label-lg: 16px;\n  --fs-label-md: 14px;\n  --fs-label-sm: 12px;\n\n  /* Line heights */\n  --lh-display-lg: 56px;\n  --lh-h1: 48px;\n  --lh-h2: 44px;\n  --lh-h3: 40px;\n  --lh-h4: 36px;\n  --lh-body: 28px;\n  --lh-quote: 24px;\n  --lh-caption: 20px;\n  --lh-micro: 20px;\n  --lh-label-lg: 18px;\n  --lh-label-md: 16px;\n  --lh-label-sm: 16px;\n\n  /* Weights */\n  --fw-regular: 300; /* @kind font */ /* Museo Sans Light — body, UI, labels */\n  --fw-medium: 500; /* @kind font */\n  --fw-bold: 700; /* @kind font */\n  --fw-black: 900; /* @kind font */\n\n  /* Tracking */\n  --tracking-tight: -0.02em;   /* headings (Display, H2–H4) */\n  --tracking-h1: 0em;          /* H1 only — see note below */\n  --tracking-h2: var(--tracking-tight); /* H2 alias of --tracking-tight, for slide markup */\n  --tracking-eyebrow: 0.14em;  /* uppercase overlines — Roboto Mono, via --font-eyebrow */\n  --tracking-button: 3px;      /* uppercase button text — Museo Sans, via --font-sans */\n\n  /* ---- Eyebrow / overline face (FIXED) ----\n     Every eyebrow in the system — slides, cards, guidelines, web — is set in\n     Roboto Mono Regular, without exception and regardless of slide type or\n     background. This is the single source for that decision; never substitute\n     the display/sans face on an eyebrow. */\n  --font-eyebrow: 'Roboto Mono', ui-monospace, monospace; /* @kind font */\n  --fw-eyebrow: 400; /* @kind font */ /* Roboto Mono regular — eyebrows and mono meta labels. Stays at 400 rather than following --fw-regular to 300: eyebrows set at 13–14px uppercase with 0.14em tracking, where a Light face loses too much stem weight to stay legible. Roboto Mono 300 is imported (used by the chapter part-numeral at 984px) but deliberately not used here. */\n}\n\n/* ---- Alignment ----\n   SQUER text is left-aligned, without exception: no centred body copy, and\n   never justified. Justification opens rivers and forces uneven word spacing,\n   which reads as broken tracking. Every text helper below therefore sets\n   text-align explicitly rather than inheriting it, so a justify on a host\n   container cannot leak into a heading or a paragraph. */\n\n/* ---- Text-style helper classes ---- */\n.sq-display  { font-family: var(--font-display); font-weight: var(--fw-black); font-size: var(--fs-display-lg); line-height: var(--lh-display-lg); letter-spacing: var(--tracking-tight);  text-align: left; }\n/* H1 gets its own, neutral tracking: negative letter-spacing is relative to font-size,\n   so the same −0.02em that reads as tight-but-comfortable at 28–36px becomes visibly\n   cramped at 40px. H1 therefore runs at 0em; all other heading steps stay at −0.02em. */\n.sq-h1 { font-family: var(--font-display); font-weight: var(--fw-black); font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--tracking-h1);  text-align: left; }\n.sq-h2 { font-family: var(--font-display); font-weight: var(--fw-black); font-size: var(--fs-h2); line-height: var(--lh-h2); letter-spacing: var(--tracking-tight);  text-align: left; }\n.sq-h3 { font-family: var(--font-display); font-weight: var(--fw-bold); font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tracking-tight);  text-align: left; }\n.sq-h4 { font-family: var(--font-display); font-weight: var(--fw-bold); font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tracking-tight);  text-align: left; }\n.sq-body  { font-family: var(--font-sans); font-weight: var(--fw-regular); font-size: var(--fs-body); line-height: var(--lh-body);  text-align: left; }\n.sq-quote { font-family: var(--font-sans); font-weight: var(--fw-regular); font-size: var(--fs-quote); line-height: var(--lh-quote); font-style: italic;  text-align: left; }\n.sq-caption { font-family: var(--font-sans); font-weight: var(--fw-regular); font-size: var(--fs-caption); line-height: var(--lh-caption);  text-align: left; }\n.sq-micro { font-family: var(--font-sans); font-weight: var(--fw-regular); font-size: var(--fs-micro); line-height: var(--lh-micro);  text-align: left; }\n.sq-eyebrow { font-family: var(--font-eyebrow); font-weight: var(--fw-eyebrow); font-size: var(--fs-caption); line-height: var(--lh-caption); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;  text-align: left; }\n.sq-label-lg { font-family: var(--font-sans); font-weight: var(--fw-medium); font-size: var(--fs-label-lg); line-height: var(--lh-label-lg);  text-align: left; }\n.sq-label-md { font-family: var(--font-sans); font-weight: var(--fw-medium); font-size: var(--fs-label-md); line-height: var(--lh-label-md);  text-align: left; }\n.sq-label-sm { font-family: var(--font-sans); font-weight: var(--fw-medium); font-size: var(--fs-label-sm); line-height: var(--lh-label-sm);  text-align: left; }\n.sq-mono { font-family: var(--font-mono); font-weight: var(--fw-medium); font-size: var(--fs-micro); line-height: var(--lh-caption);  text-align: left; }\n\n/* Safety net: text-align:justify is not a SQUER style. If a host page or an\n   editor override sets it on a container, this resets the text primitives that\n   would otherwise inherit it. Centre alignment stays possible via an explicit\n   text-align on the element itself (this rule is class-scoped, not global). */\n[style*=\"justify\"] .sq-display, [style*=\"justify\"] .sq-h1, [style*=\"justify\"] .sq-h2,\n[style*=\"justify\"] .sq-h3, [style*=\"justify\"] .sq-h4, [style*=\"justify\"] .sq-body,\n[style*=\"justify\"] .sq-quote, [style*=\"justify\"] .sq-caption, [style*=\"justify\"] .sq-micro { text-align: left; }\n\n/* SQUER — Spacing (4-pt grid)\n   Named scale transcribed from the Figma \"Spacing\" variable collection. */\n:root {\n  --space-xx-sm: 4px;\n  --space-x-sm: 8px;\n  --space-sm: 12px;\n  --space-md: 16px;\n  --space-big: 20px;\n  --space-x-big: 24px;\n  --space-xx-big: 28px;\n  --space-xxx-big: 32px;\n  --space-lg: 40px;\n  --space-x-lg: 48px;\n  --space-xx-lg: 64px;\n  --space-xxx-lg: 80px;\n  --space-huge: 96px;\n  --space-x-huge: 128px;\n  --space-xx-huge: 160px;\n  --space-xxx-huge: 192px;\n\n  /* Layout */\n  --container-max: 1152px;   /* content max-width */\n  --page-gutter: 144px;      /* desktop horizontal page padding */\n}\n\n/* SQUER — Radii, shadows, blurs, strokes\n   SQUER geometry is low-radius and precise. There is exactly ONE non-pill\n   radius: sm (0px, sharp) — used by every surface (cards, inputs, badges, panels,\n   image tiles). Buttons and labels are the only pill-shaped elements.\n   Product-UI elevation is expressed through surface LIGHTNESS (the neutral\n   dark scale), never drop shadows; the --shadow-* scale below is retained\n   only for light-mode marketing surfaces. The signature focus/active glow\n   uses brand blue 500. */\n:root {\n  /* ---- Corner radii ----\n     sm (0px, sharp) is the single standard radius for all surfaces.\n     pill is reserved for buttons + labels only. */\n  --radius-sm: 0;        /* STANDARD — cards, inputs, panels, tiles (sharp) */\n  --radius-pill: 999px;  /* buttons & labels ONLY */\n  --radius-badge: 4px;   /* BADGE-ONLY exception — deliberate, do NOT reuse elsewhere */\n\n  /* ---- Stroke weights ---- */\n  --stroke-1: 1px;\n  --stroke-2: 2px;\n\n  /* ---- Elevation (neutral) ---- */\n  --shadow-none: none;\n  --shadow-xs: 0 1px 2px rgba(16,24,40,0.05);\n  --shadow-sm: 0 1px 3px rgba(16,24,40,0.1), 0 1px 2px rgba(16,24,40,0.06);\n  --shadow-md: 0 4px 8px -2px rgba(16,24,40,0.1), 0 2px 4px -2px rgba(16,24,40,0.06);\n  --shadow-lg: 0 12px 16px -4px rgba(16,24,40,0.08), 0 4px 6px -2px rgba(16,24,40,0.03);\n  --shadow-xl: 0 20px 24px -4px rgba(16,24,40,0.08), 0 8px 8px -4px rgba(16,24,40,0.03);\n\n  /* ---- Signature glow — focus / active state, NOT a depth indicator ----\n     Brand blue 500 (30,174,233). Use on focus rings and active tabs/states. */\n  --glow-azure: 0 0 0 4px rgba(30,174,233,0.25);\n  --glow-focus: var(--glow-azure);\n  --glow-accent-red: 0 8px 32px rgba(239,15,48,0.35);\n\n  /* ---- Focus ring ---- */\n  --focus-ring: 0 0 0 2px var(--surface-page), 0 0 0 4px var(--primary-500);\n\n  /* ---- Presentation gradients (SLIDES ONLY) ----\n     The system's backgrounds are otherwise strictly FLAT (no gradient washes).\n     These two named gradients are a deliberate, documented exception scoped to\n     PRESENTATION SLIDES — never product UI, never website sections.\n     Normalised onto the brand tokens: the source spec named #20AEE9 / #1E394B,\n     which are off-brand by 2 in the red channel resp. a different dark blue;\n     they are mapped to Primary Blue 500 (#1EAEE9) and Dark Blue (#2C3747).\n     PowerPoint equivalents (PPT gradient angle = CSS angle + 90):\n       dark  → 2 stops, angle 225°   : #2C3747 @0% → #000000 @100%\n       blue  → 2 stops, angle 225°   : #1EAEE9 @0% → #004883 @100%\n     --gradient-dark is the DEFAULT slide background for every master that is\n     not a title, agenda/navigation or chapter slide: info, list, offer,\n     statement (L and XL), quote and the closing contact slide. New slides of\n     those types take it instead of a flat --surface-dark-default (#242424),\n     which stays for cards and panels sitting on top. On it: logo tone\n     color-invert, text white, emphasis in Primary Blue.\n     --gradient-blue is for chapter dividers, the title-slide frame and the\n     agenda index panel. No variants, no approximations. */\n  --gradient-dark: linear-gradient(135deg, #2C3747 0%, #000000 100%); /* @kind other */\n  --gradient-blue: linear-gradient(135deg, #1EAEE9 0%, #004883 100%); /* @kind other */\n\n  /* ---- Blur (glassmorphism overlays) ---- */\n  --blur-sm: 8px;\n  --blur-md: 16px;\n  --blur-lg: 40px;\n}\n\n/* SQUER — interaction states for primitive components.\n   Inline styles can't express :hover/:active, so shared state rules live here.\n   Uses !important-free selectors scoped by component class. */\n\n.squer-btn:hover:not(:disabled) { filter: brightness(1.08); }\n.squer-btn:active:not(:disabled) { transform: translateY(1px); filter: brightness(0.95); }\n.squer-btn--ghost { box-shadow: inset 0 0 0 1px var(--border-default); } /* resting outline as a class, NOT inline, so the :focus-visible rule below can override the box-shadow */\n.squer-btn:focus-visible { outline: none; box-shadow: var(--glow-azure); }\n\n.squer-iconbtn:hover:not(:disabled) { filter: brightness(1.08); }\n.squer-iconbtn:active:not(:disabled) { transform: translateY(1px); }\n.squer-iconbtn--ghost { box-shadow: inset 0 0 0 1px var(--border-default); } /* see .squer-btn--ghost note */\n.squer-iconbtn:focus-visible { outline: none; box-shadow: var(--glow-azure); }\n\n.squer-input input::placeholder { color: var(--text-tertiary); }\n.squer-input input { color: inherit; }\n\n.squer-footerlink { position: relative; }\n.squer-footerlink .squer-footerlink__rule { transition: background .15s ease; }\n.squer-footerlink:hover .squer-footerlink__rule { background: var(--link-hover-blue); }\n\n.squer-listitem:hover { background: var(--surface-sunken); }\n.squer-listitem:focus-visible { outline: none; box-shadow: var(--glow-focus); }\n.squer-tab { cursor: pointer; transition: color .15s ease, box-shadow .15s ease; }\n.squer-tab:focus-visible { outline: none; box-shadow: var(--glow-focus); }\n.squer-footerlink:focus-visible { outline: none; box-shadow: var(--glow-focus); }\n\n\n       \n   \n            \n           \n       \n          \n          \n        \n\n\nbutton:focus-visible,\na:focus-visible,\n[tabindex]:focus-visible { outline: none; box-shadow: var(--glow-focus); }\n<\u002Fstyle>\n<script src=\"61aa4a59-2444-445b-b9e4-603eb8e7a9ab\"><\u002Fscript>\n<style>\nbody{margin:0;background:#000}h1,h2,h3,p,ul,li{margin:0;padding:0}a{color:var(--primary-500)}a:hover{color:var(--primary-300)}\n@keyframes dk-up{from{opacity:0;transform:translateY(48px)}}\n@keyframes dk-pop{from{opacity:0;transform:scale(.5)}}\n@keyframes dk-fade{from{opacity:0}}\n@keyframes dk-hl{from{color:#fff}to{color:var(--primary-500)}}\n@keyframes dk-grow{from{transform:scaleX(0)}}\n@keyframes dk-dim{to{opacity:.16;filter:grayscale(1)}}\n@keyframes dk-alarm{0%{opacity:0}10%,30%,50%{opacity:1;transform:translateX(-10px)}20%,40%{opacity:1;transform:translateX(10px)}60%,100%{opacity:1;transform:none}}\n@keyframes dk-gone{60%{opacity:0;transform:scale(.6);width:200px;margin-right:0}100%{opacity:0;transform:scale(.6);width:0;margin-right:-72px}}\n@keyframes dk-vanish{to{opacity:0;transform:scale(.97)}}\n@keyframes dk-takeover{from{opacity:0;transform:translate(264px,108px) scale(.4375,.87)}20%{opacity:1}}\n@keyframes dk-crash{to{opacity:.14;transform:translateY(90px) rotate(14deg)}}\n@keyframes dk-strike{0%{color:#fff;max-width:1.4em}25%,55%{color:var(--destructive);opacity:1;max-width:1.4em}80%{opacity:0;max-width:1.4em}100%{color:var(--destructive);opacity:0;max-width:0}}\n[data-step]:not([data-step-on]){opacity:0;pointer-events:none}\n[data-shrink-box]{transform-origin:0 0;transition:transform 1s cubic-bezier(.65,0,.35,1),opacity 1s ease;will-change:transform}\nsection:has([data-step][data-step-on]) [data-shrink-box]{transform:translateY(-170px) scale(.45);opacity:.5}\n@media print{[data-step]{opacity:1!important}}\n@media (prefers-reduced-motion:no-preference){\n[data-step][data-step-on]{animation:dk-up .8s cubic-bezier(.2,.7,.2,1) both}\n[data-step][data-step-on][data-fx=\"fade\"]{animation:dk-fade .5s ease both}\n[data-step][data-step-on][data-fx=\"pop\"]{animation:dk-pop .5s cubic-bezier(.2,.7,.2,1) both}\n[data-deck-active] [data-anim=\"up\"]{animation:dk-up .8s cubic-bezier(.2,.7,.2,1) both}\n[data-deck-active] [data-anim=\"pop\"]{animation:dk-pop .55s cubic-bezier(.2,.7,.2,1) both}\n[data-deck-active] [data-anim=\"fade\"]{animation:dk-fade 1s ease both}\n[data-deck-active] [data-anim=\"hl\"]{animation:dk-hl .6s ease both}\n[data-deck-active] [data-anim=\"grow\"]{animation:dk-grow .9s cubic-bezier(.6,0,.2,1) both;transform-origin:left center}\n[data-deck-active] [data-anim=\"dim\"]{animation:dk-dim .8s ease forwards}\n[data-deck-active] [data-anim=\"alarm\"]{animation:dk-alarm .9s ease both}\n[data-deck-active] [data-anim=\"gone\"]{animation:dk-gone .7s ease forwards}\n[data-deck-active] [data-anim=\"vanish\"]{animation:dk-vanish .8s ease forwards}\n[data-deck-active] [data-anim=\"takeover\"]{animation:dk-takeover 1.1s cubic-bezier(.6,0,.2,1) both}\n[data-deck-active] [data-anim=\"crash\"]{animation:dk-crash 1.1s cubic-bezier(.5,0,.9,.5) forwards}\n[data-deck-active] [data-anim=\"strike\"]{animation:dk-strike 1.4s ease forwards}\n[data-deck-active] [data-anim][data-after]{animation-play-state:paused}\n[data-deck-active]:has([data-step][data-step-on]) [data-anim][data-after]{animation-play-state:running}\n}\nhtml,body{height:100%;overflow:hidden;overscroll-behavior:none}\nbody{touch-action:pinch-zoom;-webkit-tap-highlight-color:transparent;-webkit-text-size-adjust:100%}\n[data-web-deck]{position:fixed;left:0;top:0;width:1920px;height:1080px;transform-origin:0 0;transform:translate(var(--dx,0px),var(--dy,0px)) scale(var(--ds,.5));cursor:pointer;user-select:none;-webkit-user-select:none}\n[data-web-deck]>section{position:absolute!important;left:0;top:0;visibility:hidden;opacity:0;transition:opacity .35s ease,visibility 0s linear .35s}\n[data-web-deck]>section[data-deck-active]{visibility:visible;opacity:1;transition:opacity .35s ease}\n[data-web-controls]{transition:opacity .4s ease}\n[data-idle] [data-web-controls]{opacity:0}\n[data-overlay] [data-web-controls]{padding:4px!important;background:rgba(18,18,18,.6);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}\n[data-web-controls] button{background:rgba(255,255,255,.08)!important}\n[data-web-controls] [data-nav=\"next\"]{background:var(--primary-500)!important}\n[data-web-controls]:hover,[data-web-controls]:focus-within{opacity:1!important}\n[data-first] [data-nav=\"prev\"],[data-last] [data-nav=\"next\"]{opacity:.35}\n[data-portrait] [data-web-rotate]{display:flex!important}\n<\u002Fstyle>\n<script src=\"491baa6b-655d-415c-8221-331d674df198\"><\u002Fscript>\n<\u002Fhelmet>\n<div data-web-deck=\"\">\n\n<section role=\"group\" aria-roledescription=\"slide\" aria-label=\"Title\" style=\"width:1920px;height:1080px;overflow:hidden;box-sizing:border-box;font-family:var(--font-display);background:var(--gradient-blue);padding:72px\">\n<div style=\"position:relative;width:100%;height:100%;box-sizing:border-box;padding:96px;box-shadow:0 40px 90px rgba(0,0,0,.45);background:var(--gradient-dark);display:flex;flex-direction:column;justify-content:center\">\n<div data-anim=\"up\" style=\"font-family:var(--font-eyebrow);font-weight:var(--fw-eyebrow);font-size:24px;letter-spacing:.14em;text-transform:uppercase;color:var(--primary-500)\">Migration patterns for software and life<\u002Fdiv>\n<h1 data-anim=\"up\" style=\"animation-delay:.15s;margin-top:32px;max-width:1400px;font-size:120px;line-height:1.02;font-weight:var(--fw-black);letter-spacing:var(--tracking-h1);color:#fff;text-wrap:pretty\">Strangler Fig <span style=\"color:var(--primary-500)\">and a Residence Permit<\u002Fspan><\u002Fh1>\n<div data-anim=\"fade\" style=\"animation-delay:.6s;margin-top:72px;display:flex;align-item